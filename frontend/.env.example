# Copy to .env.local for local development.

# Where the FastAPI backend runs. When set, /api/* is proxied there (see next.config.ts).
# On Vercel, set BACKEND_URL on the website project to the API project's URL instead
# (e.g. https://mc-api.vercel.app). It is read at build time: redeploy after changing it.
BACKEND_URL=http://localhost:8000

# true = use mocks/sample-response.json instead of calling the API (no backend needed).
NEXT_PUBLIC_DEMO_MODE=false
