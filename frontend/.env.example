# Copy to .env.local for local development.

# Where the FastAPI backend runs. When set, /api/* is proxied there (see next.config.ts).
# Leave unset in production, where the API is served at /api on the same domain.
BACKEND_URL=http://localhost:8000

# true = use mocks/sample-response.json instead of calling the API (no backend needed).
NEXT_PUBLIC_DEMO_MODE=false
